{
    "name": "T3Code",
    "id": "t3code",
    "version": "1.0.3",
    "description": "T3Code AI-powered code editor with supervisor config and pairing API",
    "options": {
        "hostname": {
            "type": "string",
            "default": "0.0.0.0",
            "description": "Hostname to bind T3Code server"
        },
        "autostart": {
            "type": "boolean",
            "default": true,
            "description": "Start T3Code automatically via supervisor"
        }
    },
    "entrypoint": "/usr/local/bin/devdesk-t3code-entrypoint",
    "installsAfter": [
        "ghcr.io/ricky1698/devcontainer-features/devdesk-base",
        "ghcr.io/ricky1698/devcontainer-features/portal"
    ]
}
